# ── Bill-to-Solar DIY Planner ─────────────────────────────────────────────
# The MVP runs 100% client-side with no keys required (guest mode +
# localStorage). Fill these in only when you enable optional integrations.

# App branding (easy rebrand — also see lib/brand.ts)
NEXT_PUBLIC_APP_NAME="Bill-to-Solar DIY Planner"

# ── Optional: Supabase (auth, secure bill storage, saved plans) ──────────
# Create a project at https://supabase.com, run supabase/schema.sql,
# then set these. Server-only keys must NOT use the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional: AI bill-parsing layer (server-side only) ───────────────────
# Used by a future /api/parse-bill route to interpret OCR text into
# structured JSON. Never expose this key to the client.
ANTHROPIC_API_KEY=

# ── Optional: future integrations ────────────────────────────────────────
# NREL PVWatts (solar production estimates): https://developer.nrel.gov
NREL_API_KEY=
